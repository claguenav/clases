public class ticketDeporte {

	/**
	 * @param args
	 */
	public static void main(String[] args) {

		/*
		 * // Programa "malo" (valores hardcodeados, sin variables ni constantes)
		 * System.out.println("=== TICKET ===");
		 * System.out.println("Producto: Zapatillas Running");
		 * System.out.println("Unidades: " + 2); System.out.println("Precio unidad: " +
		 * 74.95); System.out.println("IVA: " + 21 + "%"); // Cálculo directo sin
		 * significado semántico System.out.println("Total: " + (2 * 74.95 * 1.21));
		 */
		
		
		final String NOMBREAPP = "Ticket de compra";
		final float VERIONAPP = 1.0f;
		
		String nombre = "Zapatillas Running";
		float unidades =2; // int porque representa una unidad entera
		float price = 74.95f; // float porque es un numero con decimales
		char categoria = 'R'; // char porque se trata de un unico caracter
		boolean esSocio = true; // boolean porque es una variable de Si / No
		long identificadorTicket = 2_000_145_876; // long porque es un numero muy alto
		int codigoTienda = 25; // unidad entera
		int calificacion = 3; // unidad entera
		float IVA = 0.21f; // final porque el IVA siempre tiene el mismo porcentaje (21%)
		float descuento = 0.10f; // float porque es decimal
		float subtotal = 0;
		float total = 0f;
		
		subtotal = unidades * price;
		IVA = subtotal * IVA;
		System.out.println(subtotal);   
		
		
		System.out.println("=== " + NOMBREAPP + "v" + VERIONAPP + " ===");
		System.out.println("Producto: " + nombre + "(cat " + categoria +")" );
		System.out.println("Unidades: " + unidades);
		System.out.println("Calificación Producto: " + calificacion);
		System.out.println("Precio unidad: " + price + " €");
		System.out.println("Subtotal: " + subtotal + " €");
		System.out.println("IVA (21%): " + IVA + " €");
		System.out.println("Descuento socio: " + descuento + " €");
		System.out.println("TOTAL: " + total );
		System.out.println("ID Ticket. " + identificadorTicket);
		System.out.println("Cliente socio: " + esSocio);
		System.out.println("Código Tienda: " + codigoTienda);
		System.out.println("==================");
		System.out.println("   _   ");
		System.out.println(" _(\")_ ");
		System.out.println("(_ . _)");
		System.out.println(" / : \\ ");
		System.out.println("(_/ \\_)");
		
		
		
		
		System.out.println("=== TICKET ===");
		System.out.println("Producto: Zapatillas Running");
		System.out.println("Unidades: " + 2); 
		System.out.println("Precio unidad: " + 74.95); 
		
		System.out.println("IVA: " + 21 + "%"); // Cálculo directo sin significado semántico 
		System.out.println("Total: " + (2 * 74.95 * 1.21));
		
		
		
		
		
				
		

	}

}
